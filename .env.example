# ============ .env 全局配置 ============
# 复制本文件为 .env 后填写。.env 已被 git 忽略，不会泄露密钥。

# ---------------- ① 大模型配置 ----------------
# 阿里云百炼控制台申请：https://bailian.console.aliyun.com/
# 建议用「通义千问」系列的视觉模型（Midscene 需要看截图）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 把下面这行换成你自己的 Key（本文件会被提交到仓库，切勿填入真实 Key）
LLM_API_KEY=sk-你的APIKey填这里
LLM_MODEL=qwen3.7-plus
# 模型家族：qwen3.7-plus 用 qwen3（必填，写错会报 Invalid MIDSCENE_MODEL_FAMILY）。
# 其他可用值：qwen2.5-vl / qwen3-vl / qwen3.5 / qwen3.6 / doubao-vision / gemini 等，
# 详见 https://midscenejs.com/zh/model-common-config
LLM_MODEL_FAMILY=qwen3

# ---------------- ② 待执行用例列表 ----------------
# 留空 = 自动执行 test_case/ 目录下所有 .yaml 文件
# 指定 = 只执行列出的文件（逗号分隔，相对于 test_case/ 目录）
# 例如：YAML_FILES=登录测试.yaml,购物车测试.yaml
YAML_FILES=

# ---------------- ③ 环境参数 ----------------
# 被测系统
BASE_URL=https://www.saucedemo.com

# 统一登录（框架自动执行，用例里不用写登录）
LOGIN_ENABLED=true
LOGIN_URL=https://www.saucedemo.com
LOGIN_USERNAME=standard_user
LOGIN_PASSWORD=secret_sauce
# 登录动作指令（{username}/{password} 会被替换成上面的账号密码）
LOGIN_STEPS=使用用户名 {username}，密码 {password} 完成登录
# 登录成功断言
LOGIN_ASSERT=登录成功进入商品列表页

# 确定性登录（可选，强烈建议配置）：配齐 用户名/密码/登录按钮 三个选择器后，
# 登录改用 Playwright fill/click 直接完成，全程 0 次大模型调用（约 80 秒 → 5 秒）。
# 选择器失效时框架自动回退上面的 AI 登录（LOGIN_STEPS），不影响使用。
# 可用浏览器 F12 → Elements 右键 Copy Selector 获取。
# 注意：选择器值必须用单引号包住（dotenv 会把值里开头的 # 当注释截断）。
LOGIN_USERNAME_SELECTOR='#user-name'          # 用户名输入框
LOGIN_PASSWORD_SELECTOR='#password'           # 密码输入框
LOGIN_BUTTON_SELECTOR='#login-button'         # 登录按钮
LOGIN_AGREEMENT_SELECTOR=''                   # 登录前需勾选的复选框（如"同意协议"），没有就留空
LOGIN_SUCCESS_SELECTOR='#inventory_container' # 登录成功后才会出现的元素（成功标记），留空则用 URL 变化判断

# 浏览器：true = 有头全屏窗口（方便看），false = 无头静默运行
FULLSCREEN=false
# 用例失败后：false = 立即停止整个运行；true = 跳过失败用例继续后面的
CONTINUE_ON_FAILURE=false
# 用例失败自动重试次数（AI 操作偶发失败，重试可显著降低假报错）
RETRY_TIMES=3
# 是否输出运行日志（midscene-run/logs/run.log）
ENABLE_LOG=true

# 调试：true = 不启动浏览器、不调大模型，只校验 YAML 写法
DRY_RUN=false

# ---------------- ④ PlaywrightAgent 参数（可选，一般不用改） ----------------
# 下面都是 Midscene 官方 Agent 构造参数，对应官方 WebPageAgentOpt/AgentOpt，
# 默认值已对齐官方源码。需要调优时再改（单位：毫秒）。
# 官方文档：https://midscenejs.com/zh/integrate-with-playwright
AGENT_GROUP_NAME=AI 自动化测试        # 报告里的分组名
AGENT_REPORT_FILE_NAME=autotest       # 官方报告文件名（生成在 report/autotest.html）
AGENT_REPORT_GENERATE=true            # 是否生成 Midscene 官方报告（含每步 AI 推理，排障用）
AGENT_PERSIST_EXECUTION_DUMP=false    # 是否持久化执行 dump
AGENT_REPLANNING_CYCLE_LIMIT=30       # aiAct 最大重规划次数
AGENT_WAIT_AFTER_ACTION=300           # 每次动作后等待，让页面稳定
AGENT_WAIT_FOR_NAVIGATION_TIMEOUT=5000 # 等待页面跳转完成
AGENT_WAIT_FOR_NETWORK_IDLE_TIMEOUT=2000 # 等待网络空闲
AGENT_FORCE_SAME_TAB_NAVIGATION=false # true=强制同页签跳转（拦截新开页签）
AGENT_FORCE_CHROME_SELECT_RENDERING=true # true=修复原生 select 下拉框点不到

# Playwright 截图跳过字体加载就绪检查（国内网络下防超时；run.bat 也已默认开启）
# PW_TEST_SCREENSHOT_NO_FONTS_READY=true
